# STCM Assistive Navigation - Environment Configuration
# =======================================================
# Copy this file to .env and fill in your API keys
#
# Quick setup:
#   cp .env.example .env
#   nano .env  # Edit and add your keys
#
# Then load before running:
#   set -a && source .env && set +a
#
# =======================================================

# OpenAI API Configuration
# -------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Used for GPT-4o and GPT-4o-mini models
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Mistral API Configuration
# --------------------------
# Get your API key from: https://console.mistral.ai/api-keys/
# Used for Mistral models (mistral-large-latest)
MISTRAL_API_KEY=your-mistral-api-key-here

# Google Gemini API Configuration
# --------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey
# Used for Gemini models
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Advanced Settings
# ----------------------------
# Uncomment and modify if needed

# Custom OpenAI API endpoint (if using proxy or alternative provider)
# OPENAI_API_BASE=https://api.openai.com/v1

# Model selection (can override at runtime)
# DEFAULT_MODEL=gpt-4o

# Python user base for dependencies (already set in CLAUDE.md)
# PYTHONUSERBASE=$HOME/.local/stcm_sys_py310

# =======================================================
# Security Notes:
# - Never commit .env to git (already in .gitignore)
# - Rotate keys periodically
# - Set spending limits in provider dashboards
# - Use read-only keys when possible
# =======================================================
