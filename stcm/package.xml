<?xml version="1.0"?>
<package format="3">
  <name>stcm</name>
  <version>0.1.0</version>
  <description>Semantic Topological Cognitive Mapping utilities for ROS 2 Humble</description>
  <maintainer email="anhar@example.com">Anhar Risnumawan</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-networkx</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-tqdm</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-shapely</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
